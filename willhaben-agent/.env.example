# Copy to .env and load it however you like (this app reads plain env vars,
# it does not parse .env itself — use `env $(cat .env | xargs) npm start`,
# docker --env-file, or your host's secrets UI).

# Shared password for the UI and API. Empty = no auth.
# Set this to something long and random before exposing the app to the internet.
AGENT_TOKEN=

PORT=8787
DATA_DIR=./data

# Polling. 60s is a sane default; the floor is 20s. See the README before
# lowering it — willhaben will start answering 429 and you end up slower.
POLL_INTERVAL_SEC=60
MIN_POLL_INTERVAL_SEC=20
MIN_REQUEST_SPACING_MS=2500

# Web Push identity. Leave empty to auto-generate into DATA_DIR/vapid.json.
# `npm run keys` prints a pair if you would rather pin them here.
# Changing these logs out every device that already subscribed.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
